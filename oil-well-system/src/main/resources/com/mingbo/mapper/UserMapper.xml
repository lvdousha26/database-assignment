    <update id="updateUserAvatarByUsername">
        update tb_user
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="gender != null and gender != ''">
                gender = #{gender},
            </if>
            <if test="addr != null and addr != ''">
                addr = #{addr},
            </if>
            <if test="avatar != null and avatar != ''">
                avatar = #{avatar},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="role != null and role != ''">
                `role` = #{role},
            </if>
        </set>
        where username = #{username};

    </update>

    <update id="updateUserAvatarById">
        update tb_user
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="gender != null and gender != ''">
                gender = #{gender},
            </if>
            <if test="addr != null and addr != ''">
                addr = #{addr},
            </if>
            <if test="avatar != null and avatar != ''">
                avatar = #{avatar},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="role != null and role != ''">
                `role` = #{role},
            </if>
        </set>
        where id = #{id};

    </update>

    <update id="updatePassqwordByUsername">
        update tb_user
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="new_pwd != null and new_pwd != ''">
                password = #{new_pwd},
            </if>

        </set>
        where username = #{username};

    </update>
    <insert id="addUser">
        INSERT INTO tb_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username != null and username != ''">
                username,
            </if>
            <if test="password != null and password != ''">
                password,
            </if>
            <if test="gender != null">
                gender,
            </if>
            <if test="addr != null and addr != ''">
                addr,
            </if>
            <if test="avatar != null and avatar != ''">
                avatar,
            </if>
            <if test="status != null">
                status,
            </if>
            <if test="role != null and role != ''">
                `role`
            </if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="username != null and username != ''">
                #{username},
            </if>
            <if test="password != null and password != ''">
                #{password},
            </if>
            <if test="gender != null">
                #{gender},
            </if>
            <if test="addr != null and addr != ''">
                #{addr},
            </if>
            <if test="avatar != null and avatar != ''">
                #{avatar},
            </if>
            <if test="status != null">
                #{status},
            </if>
            <if test="role != null and role != ''">
                #{role}
            </if>
        </trim>
    </insert>
    <delete id="deleteBatchIds">
        delete from tb_user where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="pageQueryByUsername" resultType="com.mingbo.pojo.User">
        select * from tb_user
        <where>
            <if test="username != null and username != ''">
                and username like concat('%',#{username},'%')
            </if>
        </where>
        order by id desc
        limit #{begin} , #{size}
    </select>
    <select id="employeePageQuery" resultType="com.mingbo.pojo.User">
        select * from tb_user order by id desc
    </select>
    <select id="selectTotal" resultType="java.lang.Long">
        select count(*) from tb_user
        <where>
            <if test="username != null and username != ''">
                and username like concat('%',#{username},'%')
            </if>
        </where>
        order by id desc
    </select>
</mapper>